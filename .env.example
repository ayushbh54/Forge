# ==============================================================================
# Nirmaan OS — Environment Variables
# ==============================================================================

# Server Port (Render sets this dynamically)
PORT=10000
NODE_ENV=production

# Gemini 2.0 AI Brain Master Key
GEMINI_API_KEY=your_gemini_api_key_here

# Module-specific Gemini keys (optional fallback to master key)
GEMINI_VOICE_KEY=
GEMINI_PDF_KEY=
GEMINI_RISK_KEY=
GEMINI_COPILOT_KEY=
GEMINI_LINKING_KEY=
GEMINI_FIDIC_KEY=
GEMINI_TRIANGULATION_KEY=
